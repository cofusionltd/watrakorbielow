# GEMINI_API_KEY: Optional; enables Gemini AI features.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL is not currently read by the server.
APP_URL="MY_APP_URL"

# ADMIN_API_SECRET: Required in production for administrative API operations and login.
ADMIN_API_SECRET=
# Set NODE_ENV=production in Northflank; omit it for local development.
# NODE_ENV=production

# PostgreSQL is required in all environments; the app exits if it cannot connect.
# Preferred for managed databases. The app and startup migrations both use this URL.
# Supabase pooler usernames may include the project ref (for example postgres.<project-ref>).
# The pooler username is not used as a catalog role in GRANT statements.
DATABASE_URL=

# The SQL_* variables below are used only when DATABASE_URL is empty.
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USER=watra_app
SQL_PASSWORD=
SQL_DB_NAME=watra

# In split-role setups, SQL_ADMIN_USER runs migrations and SQL_USER is the app role.
SQL_ADMIN_USER=watra_migrator
SQL_ADMIN_PASSWORD=
